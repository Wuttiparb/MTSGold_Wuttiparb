# Copy this file to .env and fill in the values from the BOT API portal.
APPLICANT_ENGLISH_NAME=
BOT_API_KEY=

# Confirm the API authentication header and response field paths in the BOT portal.
BOT_API_KEY_HEADER=Authorization
BOT_START_PERIOD_PARAM=start_period
BOT_END_PERIOD_PARAM=end_period
BOT_RECORDS_PATH=result.data.data_detail
BOT_DATE_FIELD=period
BOT_RATE_FIELD=rate
